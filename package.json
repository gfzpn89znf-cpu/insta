{
  "name": "fotogram",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fotogram - eine voll funktionsfaehige Instagram-aehnliche App mit simulierten KI-Accounts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc -b && vite build --config vite.artifact.config.ts && node build-artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
